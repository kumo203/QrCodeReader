# ReadQrCode.psm1
# PowerShell Module version of your script

#Requires -PSEdition Core
if ($PSVersionTable.PSEdition -ne 'Core') {
    throw "This module requires PowerShell Core (pwsh). Windows PowerShell (powershell.exe) is not supported."
}

# --- Load ZXing.Net assembly from Base64 string ---
$content = ''
[System.Reflection.Assembly]::Load([System.Convert]::FromBase64String($content)) | Out-Null


# -------------------------------
# Private helper: Decode a Bitmap
# -------------------------------
function Decode-QRCodeFromBitmap {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [System.Drawing.Bitmap]$Bitmap
    )

    try {
        Write-Verbose "Decoding QR code..."
        $barcodeReader = New-Object ZXing.BarcodeReader
        $result = $barcodeReader.Decode($Bitmap)

        if ($null -ne $result) {
            Write-Verbose "QR code decoded successfully. ($($result.Text.Length) chars)"
            return $result.Text
        } else {
            throw "No QR code detected. Verify the image is clear and contains a valid QR code."
        }
    }
    finally {
        if ($Bitmap) { $Bitmap.Dispose() }
    }
}


# -------------------------------
# Public Function: Read-QrCode
# -------------------------------
function Read-QrCode {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $false, Position = 0)]
        [string]$Path
    )

    try {
        if ($PSBoundParameters.ContainsKey('Path')) {

            # ---- File decoding ----
            if (-not (Test-Path -LiteralPath $Path)) {
                throw "File not found: $Path. Ensure the path is correct and the file exists."
            }

            Write-Verbose "Reading image from: $Path"
            $resolved = Resolve-Path $Path

            try {
                $image = [System.Drawing.Image]::FromFile($resolved)
            } catch {
                throw "Failed to load image: $Path. Ensure the file is a valid image format."
            }

            $bitmap = New-Object System.Drawing.Bitmap $image
            return Decode-QRCodeFromBitmap -Bitmap $bitmap
        }
        else {

            # ---- Clipboard decoding (Windows only) ----
            if (-not $IsWindows) {
                throw "Clipboard reading is only supported on Windows. Use -Path instead."
            }

            Write-Verbose "Reading image from clipboard..."
            Add-Type -AssemblyName System.Windows.Forms
            if ([System.Windows.Forms.Clipboard]::ContainsImage()) {
                $clipboardImage = [System.Windows.Forms.Clipboard]::GetImage()
                $bitmap = New-Object System.Drawing.Bitmap $clipboardImage
                return Decode-QRCodeFromBitmap -Bitmap $bitmap
            }
            else {
                throw "No image found on the clipboard. Copy an image first and try again."
            }
        }
    }
    finally {
        if ($image) { $image.Dispose() }
    }
}


# Export only the public function
Export-ModuleMember -Function Read-QrCode
